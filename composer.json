{
    "name": "palacios/framework",
    "description": "Framework MVC para PHP 8.5 inspirado no pipeline do ASP.NET Core",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Palacios\\Framework\\": "src/"
        }
    },
    "bin": [
        "bin/framework"
    ],
    "scripts": {
        "test": "phpunit",
        "test:smoke": "php tests/run.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
